+// A per-series decimal setting means "show me the real number", so it also turns
+// OFF compact notation. `getShortNumber` uses `notation: 'compact'`, which
+// renders 1234.56 as "1.2K" — raising its precision only gives "1.23K", never
+// the number the setting asks for. So an explicit decimal switches to
+// `formatNumber`; leaving it unset keeps the previous behaviour exactly.
+//
+// Read defensively because the number input hands back a string: anything that
+// is not a whole number in Intl's own 0..20 range is treated as unset rather
+// than passed on, since `maximumFractionDigits: 21` throws a RangeError that
+// would take the whole chart down with it.
+function getSeriesDecimal(serie: Series): number | null {
+	const raw = serie.decimal as unknown
+	if (raw === undefined || raw === null || raw === '') return null
+	const value = Number(raw)
+	return Number.isInteger(value) && value >= 0 && value <= 20 ? value : null
+}
+
+function formatSeriesLabel(value: number, decimal: number | null) {
+	return decimal === null ? getShortNumber(value, 1) : formatNumber(value, decimal)
+}
